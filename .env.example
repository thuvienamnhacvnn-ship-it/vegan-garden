# ---------------------------------------------------------------
# Vegan Garden Berlin - environment variables
# Copy this file to `.env.local` and fill in the real values.
# ---------------------------------------------------------------

# Public base URL of the site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3020

# ---------------------------------------------------------------
# Reservation / order handling
# ---------------------------------------------------------------
# Storage is chosen by what is configured, in this order:
#
#   1. Supabase   - when the two SUPABASE_* variables below are set.
#                   REQUIRED IN PRODUCTION: serverless filesystems are
#                   read-only and discarded, so "file" loses every booking
#                   and the admin inbox stays empty forever.
#   2. file       - ./data-store/*.json, the default for local development.
#   3. console    - set RESERVATION_STORAGE=console to only log submissions.
RESERVATION_STORAGE=file

# Supabase (Dashboard -> Project Settings -> API)
# Run supabase/schema.sql once before the first booking.
#
# The SERVICE ROLE key bypasses row-level security and must stay server-side:
# never prefix it with NEXT_PUBLIC_, never send it to the browser. The table
# holds guest names, phone numbers and delivery addresses.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Address that reservation + order notifications should be sent to.
# Leave empty in demo mode - no mail is sent.
RESERVATION_NOTIFY_EMAIL=

# ---------------------------------------------------------------
# Transactional e-mail (optional - prepared for future integration)
# ---------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Vegan Garden <no-reply@example.com>"

# ---------------------------------------------------------------
# Payments (optional - buttons + structure are prepared, not wired)
# ---------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ---------------------------------------------------------------
# Maps
# ---------------------------------------------------------------
# The site uses a keyless Google Maps embed by default.
# Provide a key only if you switch to the JS Maps API.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------
# WhatsApp notifications to the owner
# ---------------------------------------------------------------
# Without these the site still works: every reservation and order gets a
# ready-to-send wa.me link, shown in /admin and logged to the server console.
WHATSAPP_OWNER_NUMBER=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=

# ---------------------------------------------------------------
# Admin area (/admin)
# ---------------------------------------------------------------
# Single shared password. The admin area is disabled while this is empty.
ADMIN_PASSWORD=
# Optional extra salt for the session cookie signature.
# ADMIN_SECRET=
