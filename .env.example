# ---------------------------------------------------------------
# Vegan Garden Berlin - environment variables
# Copy this file to `.env.local` and fill in the real values.
# ---------------------------------------------------------------

# Public base URL of the site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3020

# ---------------------------------------------------------------
# Reservation / order handling (demo mode by default)
# ---------------------------------------------------------------
# "file"    -> writes submissions to ./data-store/*.json  (default, demo)
# "console" -> only logs submissions to the server console
RESERVATION_STORAGE=file

# Address that reservation + order notifications should be sent to.
# Leave empty in demo mode - no mail is sent.
RESERVATION_NOTIFY_EMAIL=

# ---------------------------------------------------------------
# Transactional e-mail (optional - prepared for future integration)
# ---------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Vegan Garden <no-reply@example.com>"

# ---------------------------------------------------------------
# Payments (optional - buttons + structure are prepared, not wired)
# ---------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ---------------------------------------------------------------
# Maps
# ---------------------------------------------------------------
# The site uses a keyless Google Maps embed by default.
# Provide a key only if you switch to the JS Maps API.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------
# WhatsApp notifications to the owner
# ---------------------------------------------------------------
# Without these the site still works: every reservation and order gets a
# ready-to-send wa.me link, shown in /admin and logged to the server console.
WHATSAPP_OWNER_NUMBER=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=

# ---------------------------------------------------------------
# Admin area (/admin)
# ---------------------------------------------------------------
# Single shared password. The admin area is disabled while this is empty.
ADMIN_PASSWORD=
# Optional extra salt for the session cookie signature.
# ADMIN_SECRET=
